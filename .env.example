# Copy to .env.local to switch adapters. No secrets here: the LLM key lives only in proxy/.
# sample | bank-api
VITE_TRANSACTIONS=sample
# memory | local-db
VITE_STORAGE=memory
# fake | claude | local
VITE_LLM=fake
# console | push
VITE_NOTIFIER=console
# URL of the deployed proxy, needed when VITE_LLM=claude
VITE_PROXY_URL=
